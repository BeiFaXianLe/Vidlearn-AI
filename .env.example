# VidLearn AI 本地配置（此文件不会被提交到版本库）
# 复制为 .env 后填入真实值：
#   Copy-Item .env.example .env

# ---------- 云端 LLM（仅用于文本分析：摘要/章节/知识点/问答）----------
# DeepSeek（OpenAI 兼容）
VIDLEARN_LLM_BASE_URL=https://api.deepseek.com/v1
VIDLEARN_LLM_API_KEY=
VIDLEARN_LLM_MODEL=deepseek-chat

# 其他可选服务商（改 BASE_URL/MODEL 即可，KEY 换成对应值）
#   通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   月之暗面：https://api.moonshot.cn/v1                            模型 moonshot-v1-8k
#   OpenAI：  https://api.openai.com/v1                              模型 gpt-4o-mini
#   本地 Ollama：http://127.0.0.1:11434/v1                          模型 qwen2.5:7b

# ---------- 数据与端口 ----------
VIDLEARN_DATA_ROOT=./data
VIDLEARN_PORT=8000

# ---------- 外部工具（默认走 PATH）----------
VIDLEARN_FFMPEG_PATH=ffmpeg
VIDLEARN_FFPROBE_PATH=ffprobe
VIDLEARN_YT_DLP_PATH=yt-dlp
# 抖音等需要新鲜 Cookie：从本机浏览器读取，取值 chrome / edge / firefox（留空不用）
VIDLEARN_YTDLP_COOKIES_FROM_BROWSER=

# ---------- ASR ----------
# 留空则自动使用项目内 models/faster-whisper-<model>
VIDLEARN_ASR_MODEL=small
VIDLEARN_ASR_MODEL_DIR=
VIDLEARN_ASR_DEVICE=cpu
VIDLEARN_ASR_COMPUTE_TYPE=int8
