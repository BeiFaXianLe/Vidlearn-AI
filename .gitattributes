# 统一换行：源码与脚本用 LF（避免 Windows 检出成 CRLF 导致 Linux 脚本损坏）
* text=auto eol=lf

# Shell 脚本必须 LF
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 脚本保留 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.mp4 binary
*.mkv binary
*.wav binary
*.zip binary
